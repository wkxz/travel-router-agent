# 大模型：任意 OpenAI 兼容端点，需支持 function calling 与流式输出
# LLM_BASE_URL 含 /v1，例如 https://api.deepseek.com/v1；LLM_MODEL 例如 deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 高德 Web 服务 Key（高德开放平台 → 应用管理 → 创建 Key，服务平台选「Web 服务」）
AMAP_API_KEY=

# 可选：监听地址（服务器上对外提供服务填 0.0.0.0）、端口、数据库位置、Agent 最多轮数
# HOST=127.0.0.1
# PORT=8000
# DATABASE_PATH=data/travel-agent.db
# AGENT_MAX_TURNS=30
